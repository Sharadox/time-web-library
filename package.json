{
  "name": "@sharadox/time-web-library",
  "version": "0.1.0",
  "description": "Time for local businesses: minutes in a time zone, 24-hour formatting, opening hours, rounding to a step and sunrise and sunset (with a React hook).",
  "private": false,
  "license": "SEE LICENSE IN LICENCA.md",
  "author": "Sharadox <contact@sharadox.com>",
  "type": "module",
  "exports": {
    "./*/type": {
      "sharadox-source": "./source/*/type.ts",
      "types": "./distribution/*/type.d.ts"
    },
    "./*": {
      "sharadox-source": [
        "./source/*/index.ts",
        "./source/*/index.tsx"
      ],
      "types": "./distribution/*/index.d.ts",
      "default": "./distribution/*/index.js"
    }
  },
  "files": [
    "distribution",
    "LICENCA.md",
    "LICENSE.md",
    "NOTICE.md",
    "llms.txt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.9",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf distribution && tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "documentation": "typedoc",
    "verify": "turbo run format:check lint type-check test:unit build",
    "prepare": "turborepo-configuration library && (husky || true)",
    "test:benchmark": "vitest bench --run --passWithNoTests"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yml,yaml,scss}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sharadox/time-web-library.git"
  },
  "homepage": "https://github.com/Sharadox/time-web-library#readme",
  "devDependencies": {
    "@sharadox/es-lint-configuration-web-library": "^0.1.1",
    "@sharadox/prettier-configuration-web-library": "^0.1.0",
    "@sharadox/turborepo-configuration-web-library": "^0.1.0",
    "@sharadox/type-script-configuration-web-library": "^0.2.0",
    "@sharadox/vitest-configuration-web-library": "^0.1.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "9.39.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@sharadox/web-library": "^0.5.0"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
